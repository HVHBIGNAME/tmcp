# Issue client keys in Access or with tmcp token create.
# Local management uses OS-protected IPC and needs no separate key or TCP port.

# Listener is deliberately loopback-only. Cloudflared connects to it locally.
MCP_PORT=18787
# Required for a named tunnel; quick mode discovers this automatically.
MCP_PUBLIC_URL=

# JSON array. Relative file paths are resolved under the first root.
MCP_ROOTS=["C:/coding"]
MCP_ENABLE_SHELL=true
MCP_ENABLE_SCREENSHOTS=true
MCP_MAX_FILE_BYTES=2097152
MCP_MAX_OUTPUT_CHARS=200000
MCP_COMMAND_TIMEOUT_MS=120000
MCP_DATA_DIR=.mcp-tunnel
# Optional additional browser origins, as a JSON array. No wildcards.
MCP_ALLOWED_ORIGINS=[]

# Discover MCP servers configured in installed coding clients.
MCP_GATEWAY_DISCOVER=true
# catalog: discover/call tools on demand; namespaced: also expose prefixed tools directly.
MCP_GATEWAY_MODE=catalog
# Optional additional MCP configuration files (JSON array of paths).
MCP_CONFIG_PATHS=[]
# Optional explicit servers; see mcp-servers.example.json.
MCP_SERVERS_FILE=mcp-servers.json
MCP_BACKEND_TIMEOUT_MS=300000
MCP_BACKEND_CONNECT_TIMEOUT_MS=180000

CLOUDFLARED_BIN=cloudflared
# Default: http2 on Windows, auto on Linux/macOS. Override for restricted networks.
# CLOUDFLARED_PROTOCOL=auto
CLOUDFLARED_EDGE_IP_VERSION=auto
# For a remotely managed named tunnel. Passed to cloudflared through its environment.
CLOUDFLARE_TUNNEL_TOKEN=
